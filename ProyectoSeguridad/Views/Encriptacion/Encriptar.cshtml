@model DTOs.Encryption.EncriptarDto
@{
    ViewData["Title"] = "Encriptar Mensaje";
}

<div class="container-fluid py-3 py-md-4">
    <div class="row g-4">
        <!-- Columna Principal -->
        <div class="col-12 col-lg-8">
            <!-- Header Responsivo -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
                <div class="text-center text-md-start mb-3 mb-md-0">
                    <h1 class="h2 fw-bold text-primary mb-2">
                        <i class="bi bi-lock-fill me-2"></i>Encriptar Mensaje
                    </h1>
                    <p class="text-muted mb-0">Cifra tu mensaje con AES-256 (estándar bancario)</p>
                </div>
                <div class="d-flex flex-wrap justify-content-center justify-content-md-end align-items-center gap-2">
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <span class="badge bg-success rounded-pill px-3 py-2 d-flex align-items-center">
                            <i class="bi bi-shield-check me-2"></i>
                            <span class="d-none d-sm-inline">Seguro</span>
                            <span class="d-inline d-sm-none">S</span>
                        </span>
                        <span class="badge bg-info rounded-pill px-3 py-2 d-flex align-items-center">
                            <i class="bi bi-shield-lock me-2"></i>
                            <span class="d-none d-sm-inline">Protegido</span>
                            <span class="d-inline d-sm-none">P</span>
                        </span>
                    </div>
                    <a asp-action="Desencriptar" class="btn btn-outline-primary btn-sm d-flex align-items-center">
                        <i class="bi bi-unlock-fill me-2"></i>
                        <span class="d-none d-sm-inline">Desencriptar</span>
                        <span class="d-inline d-sm-none">Descifrar</span>
                    </a>
                </div>
            </div>

            <!-- Mensajes -->
            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <div class="flex-grow-1">@ViewBag.Success</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Formulario Responsivo -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3 p-md-4">
                    <form id="encriptarForm" asp-action="Encriptar" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label asp-for="Mensaje" class="form-label fw-semibold d-flex align-items-center">
                                <i class="bi bi-chat-left-text-fill me-2"></i>Mensaje a Encriptar
                            </label>
                            <textarea asp-for="Mensaje" class="form-control"
                                      rows="4"
                                      placeholder="Escribe aquí el mensaje que deseas encriptar..."
                                      style="font-family: 'Courier New', monospace;"></textarea>
                            <span asp-validation-for="Mensaje" class="text-danger small d-block mt-1"></span>
                            <div class="form-text mt-2 d-flex align-items-center">
                                <i class="bi bi-info-circle me-2"></i>El mensaje se cifrará con AES-256-CBC
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" id="btnEncriptar" class="btn btn-primary btn-lg fw-semibold">
                                <i class="bi bi-lock me-2"></i>Encriptar Mensaje
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Resultados Responsivos -->
            @if (!string.IsNullOrEmpty(Model?.MensajeEncriptado))
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0">
                        <h3 class="h5 fw-bold text-success d-flex align-items-center">
                            <i class="bi bi-check-circle-fill me-2"></i>Mensaje Encriptado
                        </h3>
                        <div class="alert alert-info alert-dismissible fade show small mt-2 mb-0" role="alert">
                            <i class="bi bi-clock-history me-2"></i>
                            <strong>Nota:</strong> Los resultados se limpiarán automáticamente en 60 segundos
                            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                        </div>
                    </div>
                    <div class="card-body p-3 p-md-4">
                        <!-- Texto Encriptado -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold d-flex align-items-center justify-content-between flex-wrap mb-3">
                                <span class="d-flex align-items-center">
                                    <i class="bi bi-file-earmark-lock-fill me-2"></i>Texto Encriptado (Base64)
                                </span>
                                <small class="text-muted">@Model.MensajeEncriptado.Length caracteres</small>
                            </label>
                            <div class="input-group flex-column flex-md-row">
                                <textarea id="mensajeEncriptado"
                                          class="form-control bg-light mb-2 mb-md-0"
                                          rows="3"
                                          readonly
                                          style="font-family: 'Courier New', monospace;">@Model.MensajeEncriptado</textarea>
                                <button type="button"
                                        class="btn btn-outline-secondary d-flex align-items-center justify-content-center"
                                        id="copyMensajeBtn">
                                    <i class="bi bi-clipboard me-2"></i>
                                    <span>Copiar</span>
                                </button>
                            </div>
                            <div class="form-text mt-2 d-flex align-items-center">
                                <i class="bi bi-info-circle me-2"></i>Guarda este texto para desencriptar después
                            </div>
                        </div>

                        <!-- Llave de Encriptación -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold d-flex align-items-center justify-content-between flex-wrap mb-3">
                                <span class="d-flex align-items-center">
                                    <i class="bi bi-key-fill me-2"></i>Llave de Encriptación
                                </span>
                                <small class="text-muted">@Model.Llave.Length caracteres</small>
                            </label>

                            <div class="alert alert-warning d-flex align-items-center mb-3" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <div>
                                    <strong>¡IMPORTANTE!</strong> Guarda esta llave de forma segura.
                                    Sin ella no podrás desencriptar.
                                </div>
                            </div>

                            <div class="input-group flex-column flex-md-row">
                                <textarea id="llaveEncriptacion"
                                          class="form-control bg-light mb-2 mb-md-0"
                                          rows="2"
                                          readonly
                                          style="font-family: 'Courier New', monospace;">@Model.Llave</textarea>
                                <button type="button"
                                        class="btn btn-outline-warning d-flex align-items-center justify-content-center"
                                        id="copyLlaveBtn">
                                    <i class="bi bi-key me-2"></i>
                                    <span>Copiar Llave</span>
                                </button>
                            </div>
                            <div class="form-text mt-2 d-flex align-items-center">
                                <i class="bi bi-info-circle me-2"></i>Formato: Key|IV (ambos en Base64)
                            </div>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="d-grid d-md-flex justify-content-md-center gap-2">
                            <button type="button" class="btn btn-outline-primary btn-lg" onclick="limpiarFormulario()">
                                <i class="bi bi-arrow-clockwise me-2"></i>Nuevo Mensaje
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar Responsivo -->
        <div class="col-12 col-lg-4">
            <!-- Información Técnica -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0">
                    <h3 class="h5 fw-bold mb-0 d-flex align-items-center">
                        <i class="bi bi-cpu-fill me-2"></i>Detalles Técnicos
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @{
                            var detalles = new[]
                            {
                        new { Icono = "bi-check-circle-fill", Texto = "Algoritmo: AES-256" },
                        new { Icono = "bi-check-circle-fill", Texto = "Modo: CBC" },
                        new { Icono = "bi-check-circle-fill", Texto = "Key Size: 256 bits" },
                        new { Icono = "bi-check-circle-fill", Texto = "Block Size: 128 bits" },
                        new { Icono = "bi-check-circle-fill", Texto = "Padding: PKCS7" },
                        new { Icono = "bi-check-circle-fill", Texto = "IV: Aleatorio" }
                        };
                        }

                        @foreach (var detalle in detalles)
                        {
                            <div class="col-12 col-sm-6 col-lg-12">
                                <div class="d-flex align-items-center">
                                    <i class="bi @detalle.Icono text-success me-3"></i>
                                    <span class="small">@detalle.Texto</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Protección contra abuso -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0">
                    <h3 class="h5 fw-bold mb-0 d-flex align-items-center">
                        <i class="bi bi-shield-check me-2"></i>Protecciones Activas
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        @{
                            var protecciones = new[]
                            {
                        new { Texto = "Rate Limiting: 10 encriptaciones/minuto" },
                        new { Texto = "Anti-doble clic: Botón se deshabilita" },
                        new { Texto = "Auto-limpieza: Resultados en 60 segundos" },
                        new { Texto = "Delay entre copias: 1 segundo mínimo" }
                        };
                        }

                        @foreach (var proteccion in protecciones)
                        {
                            <div class="col-12">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-check-circle-fill text-success me-3"></i>
                                    <span class="small">@proteccion.Texto</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Estadísticas -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <h3 class="h5 fw-bold mb-0 d-flex align-items-center">
                        <i class="bi bi-graph-up me-2"></i>Estadísticas
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row text-center g-3">
                        <div class="col-6">
                            <div class="display-6 fw-bold text-primary">256</div>
                            <div class="small text-muted">Bits de clave</div>
                        </div>
                        <div class="col-6">
                            <div class="display-6 fw-bold text-success">3.4×10³⁸</div>
                            <div class="small text-muted">Combinaciones</div>
                        </div>
                        <div class="col-12">
                            <div class="alert alert-info small mb-0">
                                <i class="bi bi-lightbulb-fill me-2"></i>
                                <strong>Nivel militar:</strong> Usado por bancos y gobiernos
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Función para limpiar formulario
        function limpiarFormulario() {
            window.location.href = '@Url.Action("Encriptar")';
        }

        // Función para copiar al portapapeles
        async function copyToClipboard(text, buttonId, successMessage) {
            try {
                await navigator.clipboard.writeText(text);

                // Cambiar botón temporalmente
                const button = document.getElementById(buttonId);
                if (button) {
                    const originalHTML = button.innerHTML;
                    button.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i>¡Copiado!';
                    button.classList.remove('btn-outline-secondary', 'btn-outline-warning');
                    button.classList.add('btn-success');

                    setTimeout(() => {
                        button.innerHTML = originalHTML;
                        button.classList.remove('btn-success');
                        if (buttonId === 'copyMensajeBtn') {
                            button.classList.add('btn-outline-secondary');
                        } else {
                            button.classList.add('btn-outline-warning');
                        }
                    }, 2000);
                }

                // Mostrar notificación
                showNotification(successMessage, 'success');
                return true;
            } catch (err) {
                console.error('Error al copiar:', err);
                showNotification('Error al copiar. Intenta manualmente.', 'error');
                return false;
            }
        }

        // Función para mostrar notificación
        function showNotification(message, type) {
            // Crear notificación
            const notification = document.createElement('div');
            notification.className = `alert alert-${type === 'success' ? 'success' : 'danger'} position-fixed top-0 end-0 m-3`;
            notification.style.zIndex = '9999';
            notification.innerHTML = `
                <div class="d-flex align-items-center">
                    <i class="bi ${type === 'success' ? 'bi-check-circle-fill' : 'bi-x-circle-fill'} me-2"></i>
                    <div>${message}</div>
                </div>
            `;

            document.body.appendChild(notification);

            // Remover después de 3 segundos
            setTimeout(() => {
                notification.remove();
            }, 3000);
        }

        // Inicialización cuando el DOM está listo
        document.addEventListener('DOMContentLoaded', function() {
            // Deshabilitar doble clic en formulario
            const form = document.getElementById('encriptarForm');
            const submitBtn = document.getElementById('btnEncriptar');

            if (form && submitBtn) {
                form.addEventListener('submit', function(e) {
                    if (!submitBtn.disabled) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Procesando...';
                        submitBtn.classList.add('disabled');

                        // Re-habilitar después de 5 segundos por si hay error
                        setTimeout(() => {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = '<i class="bi bi-lock me-2"></i>Encriptar Mensaje';
                            submitBtn.classList.remove('disabled');
                        }, 5000);
                    }
                });
            }

            // Configurar botones de copiar
            const copyMensajeBtn = document.getElementById('copyMensajeBtn');
            const copyLlaveBtn = document.getElementById('copyLlaveBtn');

            if (copyMensajeBtn) {
                copyMensajeBtn.addEventListener('click', async function() {
                    const texto = document.getElementById('mensajeEncriptado').value;
                    await copyToClipboard(texto, 'copyMensajeBtn', 'Mensaje encriptado copiado');
                });
            }

            if (copyLlaveBtn) {
                copyLlaveBtn.addEventListener('click', async function() {
                    const texto = document.getElementById('llaveEncriptacion').value;
                    await copyToClipboard(texto, 'copyLlaveBtn', 'Llave de encriptación copiada');
                });
            }

            // Auto-limpieza después de 60 segundos
        @if (!string.IsNullOrEmpty(Model?.MensajeEncriptado))
        {
            <text>
                    setTimeout(() => {
                        const notification = document.createElement('div');
                        notification.className = 'alert alert-warning position-fixed bottom-0 start-50 translate-middle-x mb-3';
                        notification.style.zIndex = '9999';
                        notification.innerHTML = `
                            <div class="d-flex align-items-center">
                                <i class="bi bi-clock-history me-2"></i>
                                <div>Resultados limpiados automáticamente</div>
                            </div>
                        `;
                        document.body.appendChild(notification);

                        setTimeout(() => {
                            window.location.href = '@Url.Action("Encriptar")';
                        }, 1500);
                    }, 60000);
            </text>
        }
        });
    </script>
}