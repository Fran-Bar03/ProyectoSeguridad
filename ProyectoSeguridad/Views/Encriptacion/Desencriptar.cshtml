@model DTOs.Encryption.DesencriptarDto
@{
    ViewData["Title"] = "Desencriptar Mensaje";
}

<div class="container-fluid py-3 py-md-4">
    <div class="row g-4">
        <!-- Columna Principal -->
        <div class="col-12 col-lg-8">
            <!-- Header Responsivo -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
                <div class="text-center text-md-start mb-3 mb-md-0">
                    <h1 class="h2 fw-bold text-primary mb-2">
                        <i class="bi bi-unlock-fill me-2"></i>Desencriptar Mensaje
                    </h1>
                    <p class="text-muted mb-0">Descifra mensajes encriptados con AES-256</p>
                </div>
                <div class="d-flex flex-wrap justify-content-center justify-content-md-end align-items-center gap-2">
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <span class="badge bg-success rounded-pill px-3 py-2 d-flex align-items-center">
                            <i class="bi bi-shield-check me-2"></i>
                            <span class="d-none d-sm-inline">Seguro</span>
                            <span class="d-inline d-sm-none">S</span>
                        </span>
                        <span class="badge bg-info rounded-pill px-3 py-2 d-flex align-items-center">
                            <i class="bi bi-shield-lock me-2"></i>
                            <span class="d-none d-sm-inline">Protegido</span>
                            <span class="d-inline d-sm-none">P</span>
                        </span>
                    </div>
                    <a asp-action="Encriptar" class="btn btn-outline-primary btn-sm d-flex align-items-center">
                        <i class="bi bi-lock-fill me-2"></i>
                        <span class="d-none d-sm-inline">Encriptar</span>
                        <span class="d-inline d-sm-none">Cifrar</span>
                    </a>
                </div>
            </div>

            <!-- Mensajes -->
            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <div>@ViewBag.Success</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Formulario Responsivo -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3 p-md-4">
                    <form id="desencriptarForm" asp-action="Desencriptar" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Mensaje Encriptado -->
                        <div class="mb-4">
                            <label asp-for="MensajeEncriptado" class="form-label fw-semibold d-flex align-items-center">
                                <i class="bi bi-file-earmark-lock-fill me-2"></i>Mensaje Encriptado (Base64)
                            </label>
                            <textarea asp-for="MensajeEncriptado"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Pega aquí el texto encriptado en formato Base64..."
                                      style="font-family: 'Courier New', monospace;"></textarea>
                            <span asp-validation-for="MensajeEncriptado" class="text-danger small d-block mt-1"></span>
                            <div class="form-text mt-2 d-flex align-items-center">
                                <i class="bi bi-info-circle me-2"></i>Este es el texto que obtuviste al encriptar
                            </div>
                        </div>

                        <!-- Llave -->
                        <div class="mb-4">
                            <label asp-for="Llave" class="form-label fw-semibold d-flex align-items-center">
                                <i class="bi bi-key-fill me-2"></i>Llave de Desencriptación
                            </label>
                            <textarea asp-for="Llave"
                                      class="form-control"
                                      rows="2"
                                      placeholder="Pega aquí la llave en formato: Key|IV..."
                                      style="font-family: 'Courier New', monospace;"></textarea>
                            <span asp-validation-for="Llave" class="text-danger small d-block mt-1"></span>
                            <div class="form-text mt-2 d-flex align-items-center">
                                <i class="bi bi-info-circle me-2"></i>Formato: Key|IV (la misma llave que generaste al encriptar)
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" id="btnDesencriptar" class="btn btn-primary btn-lg fw-semibold">
                                <i class="bi bi-unlock me-2"></i>Desencriptar Mensaje
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Resultados Responsivos -->
            @if (!string.IsNullOrEmpty(Model?.MensajeOriginal))
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0">
                        <h3 class="h5 fw-bold text-success d-flex align-items-center">
                            <i class="bi bi-chat-square-text-fill me-2"></i>Mensaje Desencriptado
                        </h3>
                        @if (Model.Exito)
                        {
                            <div class="alert alert-info alert-dismissible fade show small mt-2 mb-0" role="alert">
                                <i class="bi bi-clock-history me-2"></i>
                                <strong>Nota:</strong> Los resultados se limpiarán automáticamente en 60 segundos
                                <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                            </div>
                        }
                    </div>
                    <div class="card-body p-3 p-md-4">
                        <!-- Texto Original -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold d-flex align-items-center mb-3">
                                <i class="bi bi-chat-left-text-fill me-2"></i>Texto Original
                            </label>
                            <div class="input-group flex-column flex-md-row">
                                <textarea id="mensajeOriginal"
                                          class="form-control bg-light mb-2 mb-md-0"
                                          rows="4"
                                          readonly
                                          style="font-family: 'Courier New', monospace;">@Model.MensajeOriginal</textarea>
                                <button type="button"
                                        class="btn btn-outline-secondary d-flex align-items-center justify-content-center"
                                        onclick="copiarResultado()">
                                    <i class="bi bi-clipboard me-2"></i>
                                    <span>Copiar</span>
                                </button>
                            </div>
                        </div>

                        <!-- Estado -->
                        <div class="alert @(Model.Exito ? "alert-success" : "alert-danger") d-flex align-items-center mb-4" role="alert">
                            <i class="bi @(Model.Exito ? "bi-check-circle-fill" : "bi-x-circle-fill") me-2"></i>
                            <div>
                                @if (Model.Exito)
                                {
                                    <strong>¡Éxito! El mensaje se desencriptó correctamente.</strong>
                                            }
                                else
                                {
                                    <strong>Error: No se pudo desencriptar el mensaje</strong>
                                            }
                            </div>
                        </div>

                        <!-- Botones -->
                        <div class="d-grid d-md-flex justify-content-md-center">
                            <button type="button" class="btn btn-outline-primary btn-lg" onclick="limpiarFormulario()">
                                <i class="bi bi-arrow-clockwise me-2"></i>Nuevo Desencriptado
                            </button>
                        </div>
                    </div>
                </div>
            }
            else if (Model?.Exito == false && (!string.IsNullOrEmpty(Model?.MensajeEncriptado) || !string.IsNullOrEmpty(Model?.Llave)))
            {
                <div class="alert alert-danger" role="alert">
                    <div class="d-flex">
                        <i class="bi bi-x-circle-fill me-2"></i>
                        <div>
                            <h5 class="alert-heading">Error de desencriptación</h5>
                            <p class="mb-2">No se pudo desencriptar el mensaje. Verifica:</p>
                            <ul class="mb-0">
                                <li>Que el texto encriptado esté completo</li>
                                <li>Que la llave sea la correcta (formato: Key|IV)</li>
                                <li>Que no haya espacios extra en la llave</li>
                                <li>Que la llave corresponda a este mensaje</li>
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar Responsivo -->
        <div class="col-12 col-lg-4">
            <!-- Instrucciones -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0">
                    <h3 class="h5 fw-bold mb-0 d-flex align-items-center">
                        <i class="bi bi-question-circle-fill me-2"></i>¿Cómo desencriptar?
                    </h3>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        @{
                            var pasos = new[]
                            {
                        new { Numero = 1, Texto = "Copia el <strong>texto encriptado</strong> completo" },
                        new { Numero = 2, Texto = "Copia la <strong>llave completa</strong> (Key|IV)" },
                        new { Numero = 3, Texto = "Pega ambos en los campos correspondientes" },
                        new { Numero = 4, Texto = "Haz clic en \"Desencriptar Mensaje\"" }
                        };
                        }

                        @foreach (var paso in pasos)
                        {
                            <div class="list-group-item border-0 px-0 py-2">
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-primary rounded-circle me-3 d-flex align-items-center justify-content-center"
                                          style="width: 30px; height: 30px;">
                                        @paso.Numero
                                    </span>
                                    <div class="small">@Html.Raw(paso.Texto)</div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="alert alert-info small mt-3 mb-0">
                        <i class="bi bi-lightbulb-fill me-2"></i>
                        <strong>Tip:</strong> Usa los botones
                        <i class="bi bi-clipboard"></i> para copiar fácilmente
                    </div>
                </div>
            </div>

            <!-- Protecciones activas -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0">
                    <h3 class="h5 fw-bold mb-0 d-flex align-items-center">
                        <i class="bi bi-shield-check me-2"></i>Protecciones
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        @{
                            var protecciones = new[]
                            {
                        new { Texto = "Rate Limiting: 10 desencriptaciones/minuto" },
                        new { Texto = "Anti-doble clic: Botón se deshabilita" },
                        new { Texto = "Auto-limpieza: Resultados en 60 segundos" }
                        };
                        }

                        @foreach (var proteccion in protecciones)
                        {
                            <div class="col-12">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-check-circle-fill text-success me-3"></i>
                                    <span class="small">@proteccion.Texto</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Consejos -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <h3 class="h5 fw-bold mb-0 d-flex align-items-center">
                        <i class="bi bi-lightbulb-fill me-2"></i>Consejos
                    </h3>
                </div>
                <div class="card-body">
                    <div class="accordion" id="accordionTips">
                        @{
                            var consejos = new[]
                            {
                        new {
                        Id = "tip1",
                        Titulo = "Verifica el formato",
                        Icono = "bi-clipboard-check",
                        Contenido = "La llave debe tener exactamente el formato: <code>Key|IV</code> donde ambos están en Base64 y separados por un pipe (|)."
                        },
                        new {
                        Id = "tip2",
                        Titulo = "Llave única por mensaje",
                        Icono = "bi-files",
                        Contenido = "Cada mensaje encriptado genera una llave única. No intentes usar llaves de otros mensajes."
                        },
                        new {
                        Id = "tip3",
                        Titulo = "Almacenamiento seguro",
                        Icono = "bi-safe",
                        Contenido = "Guarda la llave en un lugar seguro. Sin ella, el mensaje es irrecuperable."
                        }
                        };
                        }

                        @foreach (var consejo in consejos)
                        {
                            <div class="accordion-item border-0">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#@consejo.Id">
                                        <i class="bi @consejo.Icono me-2"></i>
                                        @consejo.Titulo
                                    </button>
                                </h2>
                                <div id="@consejo.Id" class="accordion-collapse collapse"
                                     data-bs-parent="#accordionTips">
                                    <div class="accordion-body small">
                                        @Html.Raw(consejo.Contenido)
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Función para limpiar formulario
        function limpiarFormulario() {
            window.location.href = '@Url.Action("Desencriptar")';
        }

        // Función para copiar resultado
        async function copiarResultado() {
            const texto = document.getElementById('mensajeOriginal').value;

            try {
                await navigator.clipboard.writeText(texto);

                // Cambiar botón temporalmente
                const button = event.target.closest('button');
                if (button) {
                    const originalHTML = button.innerHTML;
                    button.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i>¡Copiado!';
                    button.classList.remove('btn-outline-secondary');
                    button.classList.add('btn-success');

                    setTimeout(() => {
                        button.innerHTML = originalHTML;
                        button.classList.remove('btn-success');
                        button.classList.add('btn-outline-secondary');
                    }, 2000);
                }

                // Mostrar notificación
                mostrarNotificacion('Mensaje copiado al portapapeles', 'success');
            } catch (err) {
                console.error('Error al copiar:', err);
                mostrarNotificacion('Error al copiar. Intenta manualmente.', 'error');
            }
        }

        // Función para mostrar notificación
        function mostrarNotificacion(mensaje, tipo) {
            const notificacion = document.createElement('div');
            notificacion.className = `alert alert-${tipo === 'success' ? 'success' : 'danger'} position-fixed top-0 end-0 m-3`;
            notificacion.style.zIndex = '9999';
            notificacion.innerHTML = `
                <div class="d-flex align-items-center">
                    <i class="bi ${tipo === 'success' ? 'bi-check-circle-fill' : 'bi-x-circle-fill'} me-2"></i>
                    <div>${mensaje}</div>
                </div>
            `;

            document.body.appendChild(notificacion);

            setTimeout(() => {
                notificacion.remove();
            }, 3000);
        }

        // Inicialización cuando el DOM está listo
        document.addEventListener('DOMContentLoaded', function() {
            // Deshabilitar doble clic en formulario
            const form = document.getElementById('desencriptarForm');
            const submitBtn = document.getElementById('btnDesencriptar');

            if (form && submitBtn) {
                form.addEventListener('submit', function(e) {
                    if (!submitBtn.disabled) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Procesando...';
                        submitBtn.classList.add('disabled');

                        // Re-habilitar después de 5 segundos por si hay error
                        setTimeout(() => {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = '<i class="bi bi-unlock me-2"></i>Desencriptar Mensaje';
                            submitBtn.classList.remove('disabled');
                        }, 5000);
                    }
                });
            }

            // Auto-limpieza después de 60 segundos (solo si éxito)
        @if (!string.IsNullOrEmpty(Model?.MensajeOriginal) && Model.Exito)
        {
            <text>
                    setTimeout(() => {
                        const notificacion = document.createElement('div');
                        notificacion.className = 'alert alert-warning position-fixed bottom-0 start-50 translate-middle-x mb-3';
                        notificacion.style.zIndex = '9999';
                        notificacion.innerHTML = `
                            <div class="d-flex align-items-center">
                                <i class="bi bi-clock-history me-2"></i>
                                <div>Resultados limpiados automáticamente</div>
                            </div>
                        `;
                        document.body.appendChild(notificacion);

                        setTimeout(() => {
                            window.location.href = '@Url.Action("Desencriptar")';
                        }, 1500);
                    }, 60000);
            </text>
        }

            // Mejorar experiencia en móviles
            if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
                // Añadir padding seguro para iOS
                document.body.style.paddingTop = 'env(safe-area-inset-top)';
                document.body.style.paddingBottom = 'env(safe-area-inset-bottom)';
            }
        });
    </script>
}