@model DTOs.Inicio.RegistrarDto
@{
    ViewData["Title"] = "Registrarse";
}

<!-- Mensajes de error generales -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mb-4">
        <h5 class="alert-heading">
            <i class="bi bi-exclamation-octagon-fill me-2"></i>Error de Registro
        </h5>
        <div class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div class="error-message">@error.ErrorMessage</div>
            }
        </div>
    </div>
}

<div class="row justify-content-center min-vh-80 align-items-center py-4">
    <div class="col-12 col-lg-10 col-xl-8">
        <div class="card border-0 shadow-lg">
            <div class="card-body p-4 p-md-5">
                <!-- Header -->
                <div class="text-center mb-4">
                    <div class="mb-3">
                        <i class="bi bi-person-plus-fill text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h1 class="h3 fw-bold mb-2">Crear Cuenta</h1>
                    <p class="text-muted">Regístrate para usar el sistema de encriptación</p>
                </div>

                <!-- Formulario -->
                <form asp-action="Registro" method="post" class="needs-validation" novalidate id="registroForm">
                    @Html.AntiForgeryToken()

                    <!-- Datos Personales -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="Nombre" class="form-label fw-semibold">
                                <i class="bi bi-person-fill me-1"></i>Nombre(s)
                            </label>
                            <input asp-for="Nombre" class="form-control"
                                   placeholder="Juan" required>
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ApellidoPaterno" class="form-label fw-semibold">
                                Apellido Paterno
                            </label>
                            <input asp-for="ApellidoPaterno" class="form-control"
                                   placeholder="Pérez" required>
                            <span asp-validation-for="ApellidoPaterno" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ApellidoMaterno" class="form-label fw-semibold">
                                Apellido Materno
                            </label>
                            <input asp-for="ApellidoMaterno" class="form-control"
                                   placeholder="Gómez" required>
                            <span asp-validation-for="ApellidoMaterno" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold">
                            <i class="bi bi-envelope-fill me-1"></i>Correo Electrónico
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-at text-muted"></i>
                            </span>
                            <input asp-for="Email" type="email" class="form-control"
                                   placeholder="juan.perez@ejemplo.com" required>
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                        <div class="form-text">
                            <i class="bi bi-info-circle me-1"></i>Este será tu usuario para iniciar sesión
                        </div>
                    </div>

                    <!-- Contraseñas -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold">
                                <i class="bi bi-key-fill me-1"></i>Contraseña
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-lock text-muted"></i>
                                </span>
                                <input asp-for="Password" type="password" class="form-control"
                                       placeholder="••••••••" required
                                       id="passwordInput"
                                       data-minlength="6">
                                <button class="btn btn-outline-secondary" type="button"
                                        id="togglePassword1">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <div id="passwordError" class="text-danger small mt-1" style="display: none;"></div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmarPassword" class="form-label fw-semibold">
                                <i class="bi bi-key me-1"></i>Confirmar Contraseña
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-lock-fill text-muted"></i>
                                </span>
                                <input asp-for="ConfirmarPassword" type="password" class="form-control"
                                       placeholder="••••••••" required
                                       id="confirmPasswordInput">
                                <button class="btn btn-outline-secondary" type="button"
                                        id="togglePassword2">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                            <div id="confirmPasswordError" class="text-danger small mt-1" style="display: none;"></div>
                        </div>

                        <!-- Indicador de Fortaleza de Contraseña -->
                        <div class="col-12">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body p-3">
                                    <h6 class="card-title fw-semibold mb-2">
                                        <i class="bi bi-shield-check me-2"></i>Fortaleza de Contraseña
                                    </h6>
                                    <div class="progress mb-2" style="height: 8px;">
                                        <div id="passwordStrengthBar" class="progress-bar"
                                             role="progressbar" style="width: 0%"></div>
                                    </div>
                                    <div id="passwordRequirements" class="small">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="d-flex align-items-center mb-1">
                                                    <i id="lengthIcon" class="bi bi-circle me-2 text-muted"></i>
                                                    <span>Mínimo 6 caracteres</span>
                                                </div>
                                                <div class="d-flex align-items-center mb-1">
                                                    <i id="uppercaseIcon" class="bi bi-circle me-2 text-muted"></i>
                                                    <span>Al menos 1 mayúscula</span>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="d-flex align-items-center mb-1">
                                                    <i id="numberIcon" class="bi bi-circle me-2 text-muted"></i>
                                                    <span>Al menos 1 número</span>
                                                </div>
                                                <div class="d-flex align-items-center mb-1">
                                                    <i id="specialIcon" class="bi bi-circle me-2 text-muted"></i>
                                                    <span>Al menos 1 carácter especial</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Botón Submit -->
                    <div class="d-grid gap-2 mb-4">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold">
                            <i class="bi bi-person-check-fill me-2"></i>Crear Cuenta
                        </button>
                    </div>

                    <!-- Enlace a Login -->
                    <div class="text-center pt-3 border-top">
                        <p class="mb-0">
                            ¿Ya tienes cuenta?
                            <a asp-action="Login" class="text-decoration-none fw-semibold">
                                Inicia sesión aquí
                            </a>
                        </p>
                    </div>
                </form>
            </div>
        </div>

        <!-- Tarjeta de Seguridad -->
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body">
                <h6 class="card-title fw-semibold mb-3">
                    <i class="bi bi-lock-fill text-primary me-2"></i>
                    Tu seguridad es importante
                </h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-check-circle text-success me-2 mt-1"></i>
                            <div class="small">
                                <strong>Hash BCrypt</strong><br>
                                Contraseñas irreversibles
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-check-circle text-success me-2 mt-1"></i>
                            <div class="small">
                                <strong>Sin texto plano</strong><br>
                                Nunca almacenamos passwords
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-check-circle text-success me-2 mt-1"></i>
                            <div class="small">
                                <strong>HTTPS Seguro</strong><br>
                                Datos transmitidos cifrados
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Toggle passwords visibility
            function setupPasswordToggle(buttonId, inputId) {
                const button = document.getElementById(buttonId);
                if (button) {
                    button.addEventListener('click', function() {
                        const input = document.getElementById(inputId);
                        const icon = this.querySelector('i');

                        if (input.type === 'password') {
                            input.type = 'text';
                            icon.classList.remove('bi-eye');
                            icon.classList.add('bi-eye-slash');
                        } else {
                            input.type = 'password';
                            icon.classList.remove('bi-eye-slash');
                            icon.classList.add('bi-eye');
                        }
                    });
                }
            }

            setupPasswordToggle('togglePassword1', 'passwordInput');
            setupPasswordToggle('togglePassword2', 'confirmPasswordInput');

            // Elementos del indicador de fortaleza
            const passwordInput = document.getElementById('passwordInput');
            const confirmPasswordInput = document.getElementById('confirmPasswordInput');
            const passwordStrengthBar = document.getElementById('passwordStrengthBar');
            const lengthIcon = document.getElementById('lengthIcon');
            const uppercaseIcon = document.getElementById('uppercaseIcon');
            const numberIcon = document.getElementById('numberIcon');
            const specialIcon = document.getElementById('specialIcon');
            const passwordError = document.getElementById('passwordError');
            const confirmPasswordError = document.getElementById('confirmPasswordError');
            const form = document.getElementById('registroForm');

            // Validar requisitos de contraseña
            function validatePasswordRequirements(password) {
                const requirements = {
                    hasLength: password.length >= 6,
                    hasUppercase: /[A-Z]/.test(password),
                    hasNumber: /\d/.test(password),
                    hasSpecial: /[^A-Za-z0-9]/.test(password)
                };

                return requirements;
            }

            function checkPasswordStrength(password) {
                const requirements = validatePasswordRequirements(password);

                // Actualizar íconos
                updateRequirementIcon(lengthIcon, requirements.hasLength);
                updateRequirementIcon(uppercaseIcon, requirements.hasUppercase);
                updateRequirementIcon(numberIcon, requirements.hasNumber);
                updateRequirementIcon(specialIcon, requirements.hasSpecial);

                // Calcular puntaje
                let score = 0;
                if (requirements.hasLength) score += 25;
                if (requirements.hasUppercase) score += 25;
                if (requirements.hasNumber) score += 25;
                if (requirements.hasSpecial) score += 25;

                // Actualizar barra de progreso
                passwordStrengthBar.style.width = score + '%';

                // Cambiar color según fortaleza
                if (score < 50) {
                    passwordStrengthBar.className = 'progress-bar bg-danger';
                } else if (score < 75) {
                    passwordStrengthBar.className = 'progress-bar bg-warning';
                } else {
                    passwordStrengthBar.className = 'progress-bar bg-success';
                }

                return requirements;
            }

            function updateRequirementIcon(iconElement, isValid) {
                if (isValid) {
                    iconElement.className = 'bi bi-check-circle-fill me-2 text-success';
                } else {
                    iconElement.className = 'bi bi-circle me-2 text-muted';
                }
            }

            // Validar contraseña mientras se escribe
            if (passwordInput) {
                passwordInput.addEventListener('input', function() {
                    const password = this.value;

                    if (password.length === 0) {
                        // Limpiar errores y barra si está vacío
                        passwordError.style.display = 'none';
                        passwordError.textContent = '';
                        passwordStrengthBar.style.width = '0%';
                        resetIcons();
                        return;
                    }

                    const requirements = checkPasswordStrength(password);

                    // Mostrar/ocultar errores
                    if (!requirements.hasLength || !requirements.hasUppercase ||
                        !requirements.hasNumber || !requirements.hasSpecial) {
                        passwordError.textContent = 'La contraseña debe tener al menos 6 caracteres, incluyendo una mayúscula, un número y un carácter especial';
                        passwordError.style.display = 'block';
                    } else {
                        passwordError.style.display = 'none';
                        passwordError.textContent = '';
                    }

                    // Validar confirmación de contraseña
                    if (confirmPasswordInput.value) {
                        validatePasswordMatch();
                    }
                });
            }

            function resetIcons() {
                lengthIcon.className = 'bi bi-circle me-2 text-muted';
                uppercaseIcon.className = 'bi bi-circle me-2 text-muted';
                numberIcon.className = 'bi bi-circle me-2 text-muted';
                specialIcon.className = 'bi bi-circle me-2 text-muted';
            }

            // Validar que las contraseñas coincidan
            function validatePasswordMatch() {
                if (passwordInput.value !== confirmPasswordInput.value) {
                    confirmPasswordError.textContent = 'Las contraseñas no coinciden';
                    confirmPasswordError.style.display = 'block';
                    confirmPasswordInput.setCustomValidity('Las contraseñas no coinciden');
                } else {
                    confirmPasswordError.style.display = 'none';
                    confirmPasswordError.textContent = '';
                    confirmPasswordInput.setCustomValidity('');
                }
            }

            if (confirmPasswordInput) {
                confirmPasswordInput.addEventListener('input', function() {
                    if (passwordInput.value && this.value) {
                        validatePasswordMatch();
                    } else {
                        confirmPasswordError.style.display = 'none';
                        confirmPasswordError.textContent = '';
                        this.setCustomValidity('');
                    }
                });
            }

            // Validación del formulario completa
            if (form) {
                form.addEventListener('submit', function(event) {
                    let isValid = true;

                    // Validar contraseña
                    if (passwordInput && passwordInput.value) {
                        const password = passwordInput.value;
                        const requirements = validatePasswordRequirements(password);

                        if (!requirements.hasLength || !requirements.hasUppercase ||
                            !requirements.hasNumber || !requirements.hasSpecial) {
                            passwordError.textContent = 'La contraseña debe tener al menos 6 caracteres, incluyendo una mayúscula, un número y un carácter especial';
                            passwordError.style.display = 'block';
                            passwordInput.setCustomValidity('Contraseña inválida');
                            isValid = false;
                        } else {
                            passwordError.style.display = 'none';
                            passwordError.textContent = '';
                            passwordInput.setCustomValidity('');
                        }
                    }

                    // Validar que las contraseñas coincidan
                    if (passwordInput && confirmPasswordInput) {
                        if (passwordInput.value !== confirmPasswordInput.value) {
                            confirmPasswordError.textContent = 'Las contraseñas no coinciden';
                            confirmPasswordError.style.display = 'block';
                            confirmPasswordInput.setCustomValidity('Las contraseñas no coinciden');
                            isValid = false;
                        } else {
                            confirmPasswordError.style.display = 'none';
                            confirmPasswordError.textContent = '';
                            confirmPasswordInput.setCustomValidity('');
                        }
                    }

                    if (!isValid) {
                        event.preventDefault();
                        event.stopPropagation();
                        // Forzar la actualización de la validación de Bootstrap
                        form.classList.add('was-validated');
                    }

                    // Continuar con la validación nativa de Bootstrap
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }

                    form.classList.add('was-validated');
                }, false);
            }

            // Validación Bootstrap personalizada para campos requeridos
            (function () {
                'use strict'

                // Obtener todos los campos con la clase 'needs-validation'
                const forms = document.querySelectorAll('.needs-validation');

                Array.prototype.slice.call(forms).forEach(function (form) {
                    // Remover el validador anterior si existe
                    form.removeEventListener('submit', arguments.callee);

                    form.addEventListener('submit', function (event) {
                        //validador personalizado ya está manejando las contraseñas
                        // Permitir que continúe con la validación nativa
                        if (!form.checkValidity()) {
                            event.preventDefault();
                            event.stopPropagation();
                        }

                        form.classList.add('was-validated');
                    }, false);
                });
            })();
        });
    </script>
}