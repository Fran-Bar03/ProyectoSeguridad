@model DTOs.Inicio.TokenInfoViewModel
@{
    ViewData["Title"] = "Información de Token JWT";
}

<div class="container py-3 py-md-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <!-- Header Responsivo -->
            <div class="text-center mb-4">
                <h1 class="h1 fw-bold text-primary mb-3">
                    <i class="bi bi-shield-lock me-2"></i>Información del Token JWT
                </h1>
                <p class="lead text-muted mb-0">
                    Información segura sobre tu token de autenticación
                </p>
            </div>

            <!-- Tarjeta Principal Responsiva -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0">
                    <h3 class="h4 fw-bold text-primary d-flex align-items-center">
                        <i class="bi bi-person-badge me-2"></i>Datos del Usuario
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Email -->
                        <div class="col-12 col-md-4">
                            <div class="border rounded p-3 h-100">
                                <h6 class="text-muted mb-2 d-flex align-items-center">
                                    <i class="bi bi-envelope me-2"></i>Email
                                </h6>
                                <p class="fw-semibold mb-0 text-break">@Model.UsuarioEmail</p>
                            </div>
                        </div>

                        <!-- Nombre Completo -->
                        <div class="col-12 col-md-4">
                            <div class="border rounded p-3 h-100">
                                <h6 class="text-muted mb-2 d-flex align-items-center">
                                    <i class="bi bi-person me-2"></i>Nombre Completo
                                </h6>
                                <p class="fw-semibold mb-0">@Model.UsuarioNombreCompleto</p>
                            </div>
                        </div>

                        <!-- ID Usuario -->
                        <div class="col-12 col-md-4">
                            <div class="border rounded p-3 h-100">
                                <h6 class="text-muted mb-2 d-flex align-items-center">
                                    <i class="bi bi-key me-2"></i>ID Usuario
                                </h6>
                                <p class="fw-semibold mb-0 font-monospace small">@Model.UsuarioId</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información del Token Responsiva -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <h3 class="h4 fw-bold text-primary d-flex align-items-center">
                        <i class="bi bi-clock-history me-2"></i>Información del Token
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Fecha de Creación del Token -->
                    <div class="alert alert-success mb-4">
                        <div class="text-center">
                            <div class="d-flex flex-column flex-md-row align-items-center justify-content-center mb-3">
                                <i class="bi bi-calendar-check fs-4 me-0 me-md-3 mb-2 mb-md-0"></i>
                                <div class="text-center text-md-start">
                                    <div class="small text-muted">Token generado el</div>
                                    <div class="fw-bold fs-5">@Model.TokenGenerado</div>
                                </div>
                            </div>
                            <div class="mt-3">
                                <span class="badge bg-success px-3 py-2 d-inline-flex align-items-center">
                                    <i class="bi bi-infinity me-2"></i>
                                    <span>Token válido indefinidamente</span>
                                </span>
                                <div class="mt-2 small text-muted">
                                    <i class="bi bi-info-circle me-1"></i>
                                    El token será válido hasta que cierres sesión
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Vista Previa del Token Responsiva -->
                    <div class="mb-4">
                        <h5 class="fw-semibold text-primary mb-3 d-flex align-items-center">
                            <i class="bi bi-eye me-2"></i>Vista Previa del Token
                        </h5>
                        <div class="bg-light border rounded p-3">
                            <div class="mb-3">
                                <small class="text-muted d-block mb-2">Inicio del token:</small>
                                <div class="font-monospace bg-white p-2 rounded border text-break">
                                    @Model.TokenPreview
                                </div>
                            </div>
                            <div>
                                <small class="text-muted d-block mb-2">Final del token:</small>
                                <div class="font-monospace bg-white p-2 rounded border text-break">
                                    @Model.TokenUltimosCaracteres
                                </div>
                            </div>
                            <div class="mt-3 text-muted small">
                                <i class="bi bi-info-circle me-1"></i>
                                Por seguridad, solo se muestran partes del token.
                            </div>
                        </div>
                    </div>

                    <!-- Claims del Token Responsiva -->
                    <div class="mb-4">
                        <h5 class="fw-semibold text-primary mb-3 d-flex align-items-center">
                            <i class="bi bi-list-check me-2"></i>Información Incluida en el Token (Claims)
                        </h5>
                        <div class="table-responsive">
                            <table class="table table-hover table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-2">Tipo</th>
                                        <th>Valor</th>
                                        <th class="pe-2">Descripción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var claim in Model.Claims)
                                    {
                                        <tr>
                                            <td class="ps-2">
                                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">
                                                    @claim.Tipo
                                                </span>
                                            </td>
                                            <td>
                                                @if (claim.Valor == "*****PROTEGIDO*****")
                                                {
                                                    <span class="text-muted d-flex align-items-center">
                                                        <i class="bi bi-shield-check me-2"></i>
                                                        <span>Información protegida</span>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <code class="text-break">@claim.Valor</code>
                                                }
                                            </td>
                                            <td class="pe-2 small text-muted">
                                                <i class="bi bi-info-circle me-1"></i>
                                                @claim.Descripcion
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botones de Navegación Responsivos -->
            <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mt-4">
                <a asp-action="Encriptar" asp-controller="Encriptacion"
                   class="btn btn-outline-primary flex-grow-1">
                    <i class="bi bi-lock-fill me-2"></i>Volver a Encriptar
                </a>
                <form asp-action="LogOut" method="post" class="flex-grow-1">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger w-100">
                        <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Confirmar cierre de sesión
        document.querySelector('form[asp-action="LogOut"]')?.addEventListener('submit', function(e) {
            if (!confirm('¿Estás seguro de que deseas cerrar sesión?')) {
                e.preventDefault();
            }
        });

        // Mejorar experiencia en móviles
        document.addEventListener('DOMContentLoaded', function() {
            // Ajustar tabla para móviles
            const tabla = document.querySelector('.table-responsive');
            if (tabla && /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
                tabla.style.overflowX = 'auto';
                tabla.style.webkitOverflowScrolling = 'touch';
            }

            // Mejorar botones para touch
            document.querySelectorAll('.btn').forEach(btn => {
                btn.style.minHeight = '44px';
                btn.style.display = 'inline-flex';
                btn.style.alignItems = 'center';
                btn.style.justifyContent = 'center';
            });
        });
    </script>
}