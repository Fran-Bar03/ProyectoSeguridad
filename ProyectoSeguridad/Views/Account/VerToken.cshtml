@model DTOs.Inicio.TokenInfoViewModel
@{
    ViewData["Title"] = "Información de Token JWT";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Header -->
            <div class="text-center mb-5">
                <h1 class="display-5 fw-bold text-primary">
                    <i class="bi bi-shield-lock me-2"></i>Información del Token JWT
                </h1>
                <p class="lead text-muted">
                    Información segura sobre tu token de autenticación
                </p>
            </div>

            <!-- Tarjeta Principal -->
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-white border-0 pb-0">
                    <h3 class="h4 fw-bold text-primary">
                        <i class="bi bi-person-badge me-2"></i>Datos del Usuario
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <h6 class="text-muted mb-2">
                                    <i class="bi bi-envelope me-1"></i>Email
                                </h6>
                                <p class="fw-semibold mb-0">@Model.UsuarioEmail</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <h6 class="text-muted mb-2">
                                    <i class="bi bi-person me-1"></i>Nombre Completo
                                </h6>
                                <p class="fw-semibold mb-0">@Model.UsuarioNombreCompleto</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <h6 class="text-muted mb-2">
                                    <i class="bi bi-key me-1"></i>ID Usuario
                                </h6>
                                <p class="fw-semibold mb-0">@Model.UsuarioId</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información del Token -->
            <div class="card border-0 shadow-lg mt-4">
                <div class="card-header bg-white border-0">
                    <h3 class="h4 fw-bold text-primary">
                        <i class="bi bi-clock-history me-2"></i>Información del Token
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Tiempo de Vida del Token -->
                    <div class="alert @(Model.MinutosRestantes > 10 ? "alert-success" : "alert-warning") mb-4">
                        <div class="row align-items-center">
                            <div class="col-md-6 text-center">
                                <div class="d-flex align-items-center justify-content-center mb-2">
                                    <i class="bi bi-calendar-check fs-4 me-3"></i>
                                    <div>
                                        <div class="small text-muted">Generado</div>
                                        <div class="fw-bold">@Model.TokenGenerado</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 text-center">
                                <div class="d-flex align-items-center justify-content-center mb-2">
                                    <i class="bi bi-calendar-x fs-4 me-3"></i>
                                    <div>
                                        <div class="small text-muted">Expira</div>
                                        <div class="fw-bold">@Model.TokenExpira</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr>
                        <div class="text-center">
                            <span id="contadorTiempo" class="badge @(Model.MinutosRestantes > 10 ? "bg-success" : "bg-warning") fs-6 px-3 py-2">
                                <i class="bi bi-stopwatch me-2"></i>
                                <span id="tiempoRestante">@Model.MinutosRestantes:00</span>
                            </span>
                            <div class="mt-2 small text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                El contador se actualiza en tiempo real
                            </div>
                        </div>
                    </div>

                    <!-- Vista Previa del Token (SEGURA) -->
                    <div class="mb-4">
                        <h5 class="fw-semibold text-primary mb-3">
                            <i class="bi bi-eye me-2"></i>Vista Previa del Token
                        </h5>
                        <div class="bg-light border rounded p-3">
                            <div class="mb-2">
                                <small class="text-muted">Inicio del token:</small>
                                <div class="font-monospace bg-white p-2 rounded border">
                                    @Model.TokenPreview
                                </div>
                            </div>
                            <div>
                                <small class="text-muted">Final del token:</small>
                                <div class="font-monospace bg-white p-2 rounded border">
                                    @Model.TokenUltimosCaracteres
                                </div>
                            </div>
                            <div class="mt-2 text-muted small">
                                <i class="bi bi-info-circle me-1"></i>
                                Por seguridad, solo se muestran partes del token.
                            </div>
                        </div>
                    </div>

                    <!-- Claims del Token -->
                    <div class="mb-4">
                        <h5 class="fw-semibold text-primary mb-3">
                            <i class="bi bi-list-check me-2"></i>Información Incluida en el Token (Claims)
                        </h5>
                        <div class="table-responsive">
                            <table class="table table-hover table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th width="30%">Tipo de Información</th>
                                        <th width="35%">Valor</th>
                                        <th width="35%">Descripción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var claim in Model.Claims)
                                    {
                                        <tr>
                                            <td class="fw-semibold">
                                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">
                                                    @claim.Tipo
                                                </span>
                                            </td>
                                            <td>
                                                @if (claim.Valor == "*****PROTEGIDO*****")
                                                {
                                                    <span class="text-muted">
                                                        <i class="bi bi-shield-check me-1"></i>
                                                        Información protegida
                                                    </span>
                                                }
                                                else
                                                {
                                                    <code>@claim.Valor</code>
                                                }
                                            </td>
                                            <td class="small text-muted">
                                                <i class="bi bi-info-circle me-1"></i>
                                                @claim.Descripcion
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información de Seguridad -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body">
                    <h5 class="fw-semibold text-primary mb-3">
                        <i class="bi bi-shield-check me-2"></i>Medidas de Seguridad Implementadas
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-check-circle text-success me-2 mt-1"></i>
                                <div>
                                    <strong>Token Parcial</strong>
                                    <p class="small mb-0">Solo se muestran partes del token por seguridad</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-check-circle text-success me-2 mt-1"></i>
                                <div>
                                    <strong>Claims Protegidos</strong>
                                    <p class="small mb-0">Información sensible se oculta automáticamente</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-check-circle text-success me-2 mt-1"></i>
                                <div>
                                    <strong>HTTPS Obligatorio</strong>
                                    <p class="small mb-0">Tokens solo se transmiten por conexiones seguras</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-check-circle text-success me-2 mt-1"></i>
                                <div>
                                    <strong>HttpOnly Cookie</strong>
                                    <p class="small mb-0">El token no es accesible desde JavaScript</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botones de Navegación -->
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Encriptar" asp-controller="Encriptacion"
                   class="btn btn-outline-primary">
                    <i class="bi bi-lock-fill me-2"></i>Volver a Encriptar
                </a>
                <div>
                    <form asp-action="LogOut" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .font-monospace {
        font-family: 'Courier New', monospace;
        font-size: 0.9rem;
    }

    .badge {
        font-weight: 500;
        transition: all 0.5s ease;
        min-width: 130px;
        display: inline-block;
        font-family: 'Courier New', monospace;
    }

    .table th {
        font-weight: 600;
        background-color: #f8f9fa;
    }

    /* Animaciones para el contador */
    .badge.bg-warning {
        animation: pulse-warning 2s infinite;
    }

    .badge.bg-danger {
        animation: pulse-danger 1s infinite;
    }

    @@keyframes pulse-warning {
        0% {
            box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(255, 193, 7, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(255, 193, 7, 0);
        }
    }

    @@keyframes pulse-danger {
        0% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
        }
    }
</style>

<script>
    // ========== CONFIGURACIÓN INICIAL PRECISA ==========
    // Obtener la fecha de expiración REAL del token
    // Usando el timestamp Unix que viene del servidor
    const expiraUnixTimestamp = @Model.ExpiraUnixTimestamp; // En segundos

    // Convertir a milisegundos para JavaScript
    const fechaExpiracionMs = expiraUnixTimestamp * 1000;
    const fechaExpiracion = new Date(fechaExpiracionMs);

    // Elementos DOM
    const tiempoRestanteElement = document.getElementById('tiempoRestante');
    const contadorElement = document.getElementById('contadorTiempo');

    // ========== FUNCIÓN PARA CALCULAR TIEMPO RESTANTE ==========
    function calcularTiempoRestante() {
        const ahora = new Date();
        const msRestantes = fechaExpiracion - ahora;

        if (msRestantes <= 0) {
            return {
                expirado: true,
                minutos: 0,
                segundos: 0,
                msRestantes: 0
            };
        }

        const segundosTotales = Math.floor(msRestantes / 1000);
        const minutos = Math.floor(segundosTotales / 60);
        const segundos = segundosTotales % 60;

        return {
            expirado: false,
            minutos: minutos,
            segundos: segundos,
            msRestantes: msRestantes,
            segundosTotales: segundosTotales
        };
    }

    // ========== FUNCIÓN PARA ACTUALIZAR DISPLAY ==========
    function actualizarDisplay(tiempo) {
        // Formatear tiempo como MM:SS
        const tiempoFormateado =
            `${tiempo.minutos.toString().padStart(2, '0')}:${tiempo.segundos.toString().padStart(2, '0')}`;

        tiempoRestanteElement.textContent = tiempoFormateado;

        // Actualizar color según tiempo restante
        contadorElement.classList.remove('bg-success', 'bg-warning', 'bg-danger');

        if (tiempo.minutos > 10) {
            contadorElement.classList.add('bg-success');
        } else if (tiempo.minutos > 1) {
            contadorElement.classList.add('bg-warning');
        } else {
            contadorElement.classList.add('bg-danger');
        }
    }

    // ========== FUNCIÓN PRINCIPAL DEL CONTADOR ==========
    function actualizarContador() {
        const tiempo = calcularTiempoRestante();

        if (tiempo.expirado) {
            // TOKEN EXPIRADO
            tiempoRestanteElement.textContent = "00:00";
            contadorElement.innerHTML = '<i class="bi bi-clock me-2"></i>Token expirado';
            contadorElement.classList.remove('bg-success', 'bg-warning');
            contadorElement.classList.add('bg-danger');

            // Mostrar mensaje
            alert('Tu sesión ha expirado. Serás redirigido al login.');

            // Redirigir
            setTimeout(() => {
                window.location.href = '/Account/Login?message=TokenExpirado';
            }, 1000);

            clearInterval(intervalo);
            return;
        }

        // Actualizar display
        actualizarDisplay(tiempo);

        // Notificaciones
        if (tiempo.minutos === 5 && tiempo.segundos === 0) {
            mostrarNotificacion('Atención', 'Tu sesión expirará en 5 minutos');
        }

        if (tiempo.minutos === 1 && tiempo.segundos === 0) {
            mostrarNotificacion('Atención', 'Tu sesión expirará en 1 minuto');
        }

        if (tiempo.minutos === 0 && tiempo.segundos === 30) {
            mostrarNotificacion('Atención', 'Tu sesión expirará en 30 segundos');
        }
    }

    // ========== FUNCIÓN PARA NOTIFICACIONES ==========
    function mostrarNotificacion(titulo, mensaje) {
        // Crear notificación Bootstrap
        const notificacion = document.createElement('div');
        notificacion.className = 'alert alert-warning alert-dismissible fade show position-fixed';
        notificacion.style.cssText = 'top: 20px; right: 20px; z-index: 1050; max-width: 300px;';
        notificacion.innerHTML = `
            <strong>${titulo}</strong><br>${mensaje}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;

        document.body.appendChild(notificacion);

        // Auto-remover después de 5 segundos
        setTimeout(() => {
            if (notificacion.parentNode) {
                notificacion.parentNode.removeChild(notificacion);
            }
        }, 5000);
    }

    // ========== CORRECCIÓN POR DESFASE DE RELOJ ==========
    // Calcular desfase entre reloj del cliente y servidor
    const ahoraCliente = new Date();
    const ahoraServidorMs = @DateTimeOffset.UtcNow.ToUnixTimeSeconds() * 1000;
    const desfaseMs = ahoraCliente.getTime() - ahoraServidorMs;

    console.log(`Desfase reloj cliente-servidor: ${desfaseMs} ms`);

    // Ajustar fecha de expiración por desfase
    if (Math.abs(desfaseMs) > 1000) { // Si hay más de 1 segundo de diferencia
        console.log(`Ajustando fecha de expiración por ${desfaseMs} ms`);
        fechaExpiracion.setTime(fechaExpiracion.getTime() - desfaseMs);
    }

    // ========== MANEJAR RECARGA DE PÁGINA ==========
    // Guardar tiempo restante en localStorage para persistencia
    function guardarTiempoLocal() {
        const tiempo = calcularTiempoRestante();
        if (!tiempo.expirado) {
            const tiempoGuardado = {
                expira: fechaExpiracionMs,
                ultimaActualizacion: Date.now(),
                segundosTotales: tiempo.segundosTotales
            };
            localStorage.setItem('jwt_tiempo_restante', JSON.stringify(tiempoGuardado));
        }
    }

    // Recuperar tiempo guardado
    const tiempoGuardadoStr = localStorage.getItem('jwt_tiempo_restante');
    if (tiempoGuardadoStr) {
        const tiempoGuardado = JSON.parse(tiempoGuardadoStr);
        const tiempoTranscurrido = Math.floor((Date.now() - tiempoGuardado.ultimaActualizacion) / 1000);

        // Verificar que el tiempo guardado corresponde al mismo token
        if (tiempoGuardado.expira === fechaExpiracionMs && tiempoTranscurrido < 300) { // 5 minutos
            console.log('Recuperando tiempo guardado del localStorage');
            // El tiempo guardado es válido
        }
    }

    // ========== INICIAR CONTADOR ==========
    // Ejecutar inmediatamente
    actualizarContador();

    // Iniciar intervalo
    const intervalo = setInterval(actualizarContador, 1000);

    // Guardar tiempo periódicamente
    setInterval(guardarTiempoLocal, 30000); // Cada 30 segundos

    // Limpiar al salir
    window.addEventListener('beforeunload', guardarTiempoLocal);

    // ========== CORRECCIÓN PERIÓDICA ==========
    // Cada minuto, verificar y corregir desfase
    setInterval(() => {
        const tiempo = calcularTiempoRestante();
        const tiempoEsperado = @Model.SegundosRestantes + (@Model.MinutosRestantes * 60) -
                              Math.floor((Date.now() - fechaExpiracionMs + (fechaExpiracionMs - Date.now())) / 1000);

        // Si hay diferencia mayor a 5 segundos, recargar
        if (Math.abs(tiempo.segundosTotales - tiempoEsperado) > 5) {
            console.log('Desfase detectado, recargando contador...');
            location.reload();
        }
    }, 60000); // Cada minuto
</script>