@{
    var token = Context.Request.Cookies["jwt_token"];
    int minutosRestantes = 0;
    int segundosRestantes = 0;
    long expiraUnixTimestamp = 0;

    if (!string.IsNullOrEmpty(token))
    {
        try
        {
            var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
            var jsonToken = handler.ReadToken(token) as System.IdentityModel.Tokens.Jwt.JwtSecurityToken;

            var expClaim = jsonToken?.Claims.FirstOrDefault(c => c.Type == System.IdentityModel.Tokens.Jwt.JwtRegisteredClaimNames.Exp);
            if (expClaim != null && long.TryParse(expClaim.Value, out long expTimestamp))
            {
                expiraUnixTimestamp = expTimestamp;

                var fechaExpiracionUtc = DateTimeOffset.FromUnixTimeSeconds(expTimestamp).UtcDateTime;
                var fechaExpiracionHermosillo = Data.Helpers.TimeZoneHelper.ToHermosilloTime(fechaExpiracionUtc);
                var ahoraHermosillo = Data.Helpers.TimeZoneHelper.NowInHermosillo();

                var tiempoRestante = fechaExpiracionHermosillo - ahoraHermosillo;
                minutosRestantes = Math.Max(0, (int)Math.Floor(tiempoRestante.TotalMinutes));
                segundosRestantes = Math.Max(0, (int)tiempoRestante.TotalSeconds % 60);
            }
        }
        catch { }
    }
}

@if (User.Identity.IsAuthenticated && minutosRestantes > 0 && !Context.Request.Path.StartsWithSegments("/Account/VerToken"))
{
    <div id="simpleTokenTimer" class="position-fixed top-0 end-0 m-3" style="z-index: 1040;">
        <span id="simpleTiempoRestante"
              class="badge @(minutosRestantes > 10 ? "bg-success" : minutosRestantes > 2 ? "bg-warning" : "bg-danger") px-3 py-2">
            <i class="bi bi-clock me-1"></i>
            <span id="timerText">@minutosRestantes.ToString("00"):@segundosRestantes.ToString("00")</span>
        </span>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Verificar que no estamos en la página de VerToken
            if (window.location.pathname.includes('/Account/VerToken')) {
                const timerElement = document.getElementById('simpleTokenTimer');
                if (timerElement) {
                    timerElement.style.display = 'none';
                    return;
                }
            }

            // Usar el timestamp Unix del servidor para precisión
            const expiraUnixTimestamp = @expiraUnixTimestamp;
            const fechaExpiracionMs = expiraUnixTimestamp * 1000;
            const fechaExpiracion = new Date(fechaExpiracionMs);

            // Ajustar por diferencia de tiempo del cliente
            const ahoraCliente = new Date();
            const ahoraServidorMs = @DateTimeOffset.UtcNow.ToUnixTimeSeconds() * 1000;
            const desfaseMs = ahoraCliente.getTime() - ahoraServidorMs;

            if (Math.abs(desfaseMs) > 1000) {
                fechaExpiracion.setTime(fechaExpiracion.getTime() - desfaseMs);
            }

            const tiempoRestanteElement = document.getElementById('simpleTiempoRestante');
            const timerText = document.getElementById('timerText');

            function calcularTiempoRestante() {
                const ahora = new Date();
                const msRestantes = fechaExpiracion - ahora;

                if (msRestantes <= 0) {
                    return {
                        expirado: true,
                        minutos: 0,
                        segundos: 0,
                        msRestantes: 0
                    };
                }

                const segundosTotales = Math.floor(msRestantes / 1000);
                const minutos = Math.floor(segundosTotales / 60);
                const segundos = segundosTotales % 60;

                return {
                    expirado: false,
                    minutos: minutos,
                    segundos: segundos,
                    segundosTotales: segundosTotales
                };
            }

            function actualizarSimpleContador() {
                const tiempo = calcularTiempoRestante();

                if (tiempo.expirado) {
                    timerText.textContent = "00:00";
                    tiempoRestanteElement.classList.remove('bg-success', 'bg-warning', 'bg-danger');
                    tiempoRestanteElement.classList.add('bg-danger', 'critical-blink');

                    setTimeout(() => {
                        window.location.href = '/Account/Login?message=TokenExpirado';
                    }, 1000);

                    clearInterval(intervalo);
                    return;
                }

                // Actualizar texto
                timerText.textContent =
                    `${tiempo.minutos.toString().padStart(2, '0')}:${tiempo.segundos.toString().padStart(2, '0')}`;

                // Actualizar color
                tiempoRestanteElement.classList.remove('bg-success', 'bg-warning', 'bg-danger', 'critical-blink');

                if (tiempo.minutos > 10) {
                    tiempoRestanteElement.classList.add('bg-success');
                } else if (tiempo.minutos > 2) {
                    tiempoRestanteElement.classList.add('bg-warning');
                } else {
                    tiempoRestanteElement.classList.add('bg-danger');

                    // Solo parpadea en el último minuto
                    if (tiempo.minutos < 1) {
                        tiempoRestanteElement.classList.add('critical-blink');
                    }
                }

                // Notificaciones
                if (tiempo.minutos === 5 && tiempo.segundos === 0) {
                    mostrarNotificacionSimple('Atención', 'Tu sesión expirará en 5 minutos');
                }

                if (tiempo.minutos === 1 && tiempo.segundos === 0) {
                    mostrarNotificacionSimple('Atención', 'Tu sesión expirará en 1 minuto');
                }
            }

            // Estilo para el parpadeo
            const style = document.createElement('style');
            style.textContent = `
                .critical-blink {
                    animation: blink 1s infinite;
                }

                @@keyframes blink {
                    0%, 100% { opacity: 1; }
                    50% { opacity: 0.5; }
                }
            `;
            document.head.appendChild(style);

            function mostrarNotificacionSimple(titulo, mensaje) {
                // Solo mostrar si estamos en la vista activa
                if (document.hidden) return;

                // Crear notificación simple
                const notificacion = document.createElement('div');
                notificacion.className = 'alert alert-warning alert-dismissible fade show position-fixed';
                notificacion.style.cssText = 'top: 80px; right: 20px; z-index: 1050; max-width: 300px;';
                notificacion.innerHTML = `
                    <strong>${titulo}</strong><br>${mensaje}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;

                document.body.appendChild(notificacion);

                setTimeout(() => {
                    if (notificacion.parentNode) {
                        notificacion.parentNode.removeChild(notificacion);
                    }
                }, 5000);
            }

            // Iniciar el contador
            actualizarSimpleContador();
            const intervalo = setInterval(actualizarSimpleContador, 1000);

            // Pausar contador cuando la pestaña no está activa para ahorrar recursos
            document.addEventListener('visibilitychange', function() {
                if (document.hidden) {
                    clearInterval(intervalo);
                } else {
                    // Al volver activa, recalcular y reiniciar
                    actualizarSimpleContador();
                    intervalo = setInterval(actualizarSimpleContador, 1000);
                }
            });
        });
    </script>
}