@inject IHttpContextAccessor HttpContextAccessor
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Sistema de Seguridad</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <!-- CSS personalizado mínimo -->
    <style>
        /* Solo estilos esenciales */
        .navbar-toggler:focus {
            box-shadow: 0 0 0 0.15rem;
        }

        .btn-touch {
            min-height: 44px;
            min-width: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        textarea {
            resize: vertical;
            min-height: 100px;
        }

        /* Mejorar experiencia en móviles */
        @@media (max-width: 768px) {
            .container, .container-fluid {
                padding-left: 0.75rem;
                padding-right: 0.75rem;
            }

            .card-body {
                padding: 1rem !important;
            }

            .btn-lg {
                padding: 0.75rem 1rem !important;
                font-size: 1rem !important;
            }

            .navbar-nav .nav-link {
                padding: 0.5rem 1rem;
            }

            footer .text-md-end {
                text-align: center !important;
                margin-top: 0.5rem;
            }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body class="bg-light">
    <!-- Navbar Responsive -->
    <nav class="navbar navbar-expand-lg navbar-white bg-white shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary d-flex align-items-center" asp-controller="Account" asp-action="Login">
                <i class="bi bi-shield-lock-fill me-2"></i>
                <span class="d-none d-sm-inline">SecureEncrypt</span>
                <span class="d-inline d-sm-none">SE</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                    aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center btn-touch" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-2"></i>
                                <span class="d-none d-md-inline">
                                    @User.FindFirst("NombreCompleto")?.Value
                                </span>
                                <span class="d-inline d-md-none">Cuenta</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" asp-controller="Encriptacion" asp-action="Encriptar">
                                        <i class="bi bi-lock-fill me-2"></i>Encriptar
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" asp-controller="Encriptacion" asp-action="Desencriptar">
                                        <i class="bi bi-unlock-fill me-2"></i>Desencriptar
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" asp-controller="Account" asp-action="VerToken">
                                        <i class="bi bi-shield-check me-2"></i>Ver Mi Token
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="LogOut" method="post" id="logoutForm">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger d-flex align-items-center w-100">
                                            <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center btn-touch" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                <span>Iniciar Sesión</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center btn-touch" asp-controller="Account" asp-action="Registro">
                                <i class="bi bi-person-plus-fill me-2"></i>
                                <span>Registrarse</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Mensajes de Estado -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Contenido Principal -->
    <main class="container py-4">
        @RenderBody()
    </main>

    <!-- Footer Responsive -->
    <footer class="bg-white border-top mt-auto py-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-12 col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <span class="text-muted d-flex align-items-center justify-content-center justify-content-md-start">
                        <i class="bi bi-shield-check me-2"></i>
                        Sistema de Seguridad &copy; @DateTime.Now.Year
                    </span>
                </div>
                <div class="col-12 col-md-6 text-center text-md-end">
                    <small class="text-muted">
                        <span class="d-block d-md-inline mb-1 mb-md-0">
                            <i class="bi bi-lock-fill me-1"></i>AES-256
                        </span>
                        <span class="d-none d-md-inline mx-2">|</span>
                        <span class="d-block d-md-inline mb-1 mb-md-0">
                            <i class="bi bi-key-fill me-1"></i>JWT
                        </span>
                        <span class="d-none d-md-inline mx-2">|</span>
                        <span class="d-block d-md-inline">
                            <i class="bi bi-hash me-1"></i>BCrypt
                        </span>
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Scripts básicos -->
    <script>
        // Confirmar logout
        document.getElementById('logoutForm')?.addEventListener('submit', function(e) {
            if (!confirm('¿Estás seguro de que quieres cerrar sesión?')) {
                e.preventDefault();
            }
        });

        // Auto-resize textareas
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('textarea').forEach(textarea => {
                textarea.addEventListener('input', function() {
                    this.style.height = 'auto';
                    this.style.height = (this.scrollHeight) + 'px';
                });
                // Trigger inicial
                textarea.dispatchEvent(new Event('input'));
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>